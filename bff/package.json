    "pino-pretty": "^13.1.3",
    "uuid": "^14.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
