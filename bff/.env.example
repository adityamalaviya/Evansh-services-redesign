# BFF Environment Variables

NODE_ENV=development

# Pipeline service URL (use http://pipeline:8000 for Docker Compose, Render URL for production)
PIPELINE_URL=http://localhost:8000

# Shared secret between BFF and Pipeline
PIPELINE_SERVICE_TOKEN=

# Appwrite server-side config
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DB_ID=
APPWRITE_BUCKET_ID=

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Email
ADMIN_EMAIL=
RESEND_API_KEY=

# Cookie signing secret
COOKIE_SECRET=change-me-to-a-long-random-string
