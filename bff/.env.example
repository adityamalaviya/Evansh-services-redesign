# BFF Environment Variables

NODE_ENV=development

# Appwrite server-side config
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DB_ID=
APPWRITE_BUCKET_ID=

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Email (Native SMTP — works with Gmail App Password or custom SMTP, no 3rd-party API key needed)
ADMIN_EMAIL=
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-google-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_FROM="Evansh Services" <your-email@gmail.com>

# Optional Fallback (Resend API)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
